{
    "version": "2.0.0",
    "tasks": [
        {
            "type": "shell",
            "label": "gcc: 编译当前文件",
            "command": "gcc",
            "args": [
                "-std=c11",
                "-Wall",
                "-Wextra",
                "-g",
                "-O2",
                "${file}",
                "-lm",
                "-o",
                "${fileDirname}\\${fileBasenameNoExtension}.exe"
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "使用 gcc 编译当前打开的 .c 文件，生成同名 .exe"
        },
        {
            "type": "shell",
            "label": "gcc: 编译并运行当前文件",
            "command": "${fileDirname}\\${fileBasenameNoExtension}.exe",
            "dependsOn": "gcc: 编译当前文件",
            "options": {
                "cwd": "${fileDirname}"
            },
            "problemMatcher": [],
            "group": "test",
            "detail": "先编译，再运行生成的 .exe"
        },
        {
            "type": "shell",
            "label": "make: 编译全部",
            "command": "make",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "detail": "在项目根目录执行 make，编译所有 .c 文件"
        },
        {
            "type": "shell",
            "label": "make: 清理",
            "command": "make clean",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [],
            "detail": "在项目根目录执行 make clean"
        }
    ]
}
